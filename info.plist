<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>bundleid</key>
	<string>com.starcat.alfred</string>
	<key>category</key>
	<string>Tools</string>
	<key>connections</key>
	<dict>
		<key>starcat-script-filter</key>
		<array>
			<dict>
				<key>destinationuid</key>
				<string>starcat-open-url</string>
				<key>modifiers</key>
				<integer>0</integer>
				<key>modifiersubtext</key>
				<string></string>
				<key>vitoclose</key>
				<false/>
			</dict>
		</array>
	</dict>
	<key>createdby</key>
	<string>Starcat</string>
	<key>description</key>
	<string>Search Starcat local repositories and GitHub, then open the selected repository.</string>
	<key>disabled</key>
	<false/>
	<key>name</key>
	<string>Starcat Repository Search</string>
	<key>objects</key>
	<array>
		<dict>
			<key>config</key>
			<dict>
				<!-- Starcat CLI owns searching and ranking. Alfred must forward every
				     query change instead of filtering one empty-query response locally. -->
				<key>alfredfiltersresults</key>
				<false/>
				<key>argumenttype</key>
				<integer>0</integer>
				<key>keyword</key>
				<string>{var:keyword}</string>
				<key>queuedelaycustom</key>
				<integer>1</integer>
				<key>queuedelayimmediatelyinitially</key>
				<true/>
				<key>queuemode</key>
				<integer>2</integer>
				<key>script</key>
				<string>./bin/starcat-alfred search "$1"</string>
				<key>scriptargtype</key>
				<integer>1</integer>
				<key>type</key>
				<integer>0</integer>
				<key>withspace</key>
				<true/>
			</dict>
			<key>type</key>
			<string>alfred.workflow.input.scriptfilter</string>
			<key>uid</key>
			<string>starcat-script-filter</string>
			<key>version</key>
			<integer>3</integer>
		</dict>
		<dict>
			<key>config</key>
			<dict>
				<key>spaces</key>
				<string></string>
				<key>url</key>
				<string>{query}</string>
				<key>utf8</key>
				<true/>
			</dict>
			<key>type</key>
			<string>alfred.workflow.action.openurl</string>
			<key>uid</key>
			<string>starcat-open-url</string>
			<key>version</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>readme</key>
	<string>Type “starcat” followed by a repository keyword. Local results open in Starcat; GitHub-only results open in the browser.</string>
	<key>uidata</key>
	<dict>
		<key>starcat-open-url</key>
		<dict>
			<key>xpos</key>
			<real>480</real>
			<key>ypos</key>
			<real>200</real>
		</dict>
		<key>starcat-script-filter</key>
		<dict>
			<key>xpos</key>
			<real>180</real>
			<key>ypos</key>
			<real>200</real>
		</dict>
	</dict>
	<key>userconfigurationconfig</key>
	<array>
		<dict>
			<key>config</key>
			<dict>
				<key>default</key>
				<string>starcat</string>
				<key>required</key>
				<true/>
				<key>trim</key>
				<true/>
			</dict>
			<key>description</key>
			<string>Keyword used to trigger repository search.</string>
			<key>label</key>
			<string>Keyword</string>
			<key>type</key>
			<string>textfield</string>
			<key>variable</key>
			<string>keyword</string>
		</dict>
		<dict>
			<key>config</key>
			<dict>
				<key>default</key>
				<string></string>
				<key>required</key>
				<false/>
				<key>trim</key>
				<true/>
			</dict>
			<key>description</key>
			<string>Optional absolute path. Leave empty to auto-detect starcat.</string>
			<key>label</key>
			<string>CLI Path</string>
			<key>type</key>
			<string>textfield</string>
			<key>variable</key>
			<string>starcat_cli_path</string>
		</dict>
		<dict>
			<key>config</key>
			<dict>
				<key>default</key>
				<string>30</string>
				<key>required</key>
				<true/>
				<key>trim</key>
				<true/>
			</dict>
			<key>description</key>
			<string>Number of results, from 5 to 50.</string>
			<key>label</key>
			<string>Result Limit</string>
			<key>type</key>
			<string>textfield</string>
			<key>variable</key>
			<string>result_limit</string>
		</dict>
	</array>
	<key>variables</key>
	<dict>
		<key>keyword</key>
		<string>starcat</string>
		<key>result_limit</key>
		<string>30</string>
		<key>starcat_cli_path</key>
		<string></string>
	</dict>
	<key>version</key>
	<string>1.0.1</string>
	<key>webaddress</key>
	<string>https://github.com/starcat-app/starcat-alfred-workflow</string>
</dict>
</plist>
